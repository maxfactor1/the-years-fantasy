# Yahoo Fantasy Sports API credentials
# Register your app at https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here
YAHOO_LEAGUE_ID=179398

# The most recently completed season (the one whose week 14 rosters define keeper eligibility)
YAHOO_PREVIOUS_SEASON=2025

# The upcoming draft season (keepers are being calculated FOR this year)
YAHOO_UPCOMING_SEASON=2026

# FantasyPros API
FANTASYPROS_API_KEY=your_fantasypros_key_here

# Admin password for the /admin management page
ADMIN_PASSWORD=changeme_use_a_strong_password

# Secret key for signing admin session tokens (generate a long random string)
SECRET_KEY=replace_with_a_long_random_secret_key_at_least_32_chars

# OAuth callback URL — set to your TrueNAS hostname/IP for external access
# During initial setup, this must match what you registered in the Yahoo Developer console
OAUTH_REDIRECT_URI=http://localhost:8000/setup/callback

# Port the app listens on inside the container
PORT=8000
